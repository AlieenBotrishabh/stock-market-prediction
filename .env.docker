# Docker Compose environment. Copy to .env and fill in real values.
# NEVER commit a file containing real credentials.
#
# NOTE: a live IndianAPI key was previously committed in this file. It is
# in git history and must be treated as compromised — rotate it.

# --- IndianAPI (server-side only) ---
# The backend reads INDIAN_API_KEY; keep the two names in sync.
INDIAN_API_KEY=
INDIANAPI_KEY=

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017/stockmarket
MONGODB_URI=mongodb://mongo:27017/stockmarket
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# --- Server ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# --- Frontend ---
# Every VITE_* value is inlined into the public bundle. No secrets here.
VITE_API_URL=/api

# --- ML pipeline paths ---
ML_DATA_PATH=/app/ml-pipeline/data
ML_MODEL_PATH=/app/ml-pipeline/models

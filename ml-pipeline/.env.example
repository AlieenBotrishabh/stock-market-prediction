# ML pipeline environment. Copy to .env and fill in.
# NEVER commit a file containing real values.

# --- MongoDB (optional) ---
# Where predictions and backtest metrics are published. Without it the
# pipeline still trains and reports locally, it just does not publish.
MONGODB_URI=
MONGODB_DB=stockmarket

# --- Model ---
# Bumping this trains/publishes under a new version rather than
# overwriting the existing one.
MODEL_VERSION=lstm-150-single-v1

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Note: no API key is needed. Market data comes from Yahoo Finance, which
# requires no authentication. IndianAPI is used only by the backend.

# .gitignore file for stock-market-prediction

# ─── Secrets ────────────────────────────────────────────
# Every .env variant is ignored by default. Only *.example files are
# tracked, and those must contain placeholders — never real values.
# NOTE: .env.production was previously tracked WITH a live API key. That
# key is in git history and must be treated as compromised/rotated.
.env
.env.*
!.env.example
!**/.env.example
.env.docker

# Backend
backend/node_modules/
backend/package-lock.json
backend/dist/

# Frontend
frontend/node_modules/
frontend/package-lock.json
frontend/dist/
frontend/build/
frontend/.vite/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temp
.temp/
tmp/
*.tmp
.vercel

# Node (root workspace)
node_modules/

# Python / ML pipeline artifacts
__pycache__/
*.py[cod]
.venv/
venv/
ml-pipeline/data/
ml-pipeline/models/
ml-pipeline/scalers/
# ml-pipeline/export/ is deliberately COMMITTED. The API loads model
# bundles from it, so shipping them with the code means forecasts work on a
# fresh deploy with no scheduled job, no Hugging Face fetch and no network
# dependency at request time. Deduplicated to ~590 KB: one shared graph
# under _shared/ plus small per-company config and metrics.
ml-pipeline/reports/

# Debug leftovers (captured API responses)
temp_*.json
yahoo_*.json

# Backend environment. Copy to backend/.env and fill in.
# NEVER commit a file containing real values.

# --- Server ---
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins. Leave unset to allow all
# (fine for local dev; set it in production).
# FRONTEND_URL=https://your-app.vercel.app

# --- MongoDB (optional) ---
# Without this the API still serves live market data; it loses the shared
# response cache and the stored ML predictions.
MONGODB_URI=

# --- IndianAPI (https://stock.indianapi.in) ---
# Server-side only. Do NOT prefix with VITE_ and do NOT put it in any
# frontend env file: VITE_* variables are inlined into the public bundle.
INDIAN_API_KEY=
# INDIAN_API_BASE_URL=https://stock.indianapi.in

# Frontend environment variables.
#
# WARNING: every VITE_* var is inlined into the public JS bundle at build
# time. Never put a secret in this file. API keys belong in the backend
# environment only (see backend/.env.example).

# Base URL for our own backend API.
#   - local dev:  leave unset; vite.config.js proxies /api -> localhost:5000
#   - production: /api  (same-origin, handled by the Vercel rewrite)
VITE_API_URL=/api
